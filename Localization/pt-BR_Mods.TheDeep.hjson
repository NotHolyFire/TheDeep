	AFishingRodMostIdeal: {
		DisplayName: A Fishing Pole Most Ideal
		Tooltip:
			'''
			Fly, broken wings
			I know you are still with me
			All I need is a nudge to get me started
			Fly, broken wings
			To somewhere we can be free
			Closer to our ideal
			[...]
			Please die, little dreams
			Kill the camellias in me
			Wouldn't it be easier to give in?
			Why are these hands chasing dreams out of my reach?
			Is my thirst for normalcy odd?
			Fly, perfect wings (goodbye, goodbye, goodbye)
			Where have you been hiding? (Goodbye, goodbye, goodbye)
			Bring me to the mind that got us started
			Fly, perfect wings (goodbye, goodbye, goodbye)
			Show them who I can be (goodbye, goodbye, goodbye)
			For the one last time, if you will
			That's all
			'''
	}

	Gunpowderfish: {
		DisplayName: Peixe-Pólvora
		Tooltip: "'Estranhamente, ele não é relacionado ao Robalomite em qualquer forma'"
	}

	OilFish: {
		DisplayName: Barbatanas de óleo
		Tooltip: "'Esses peixes são poças de óleo vivas encontradas no subterrâneo. Eles são extremamente inflamavéis, então são usados como combustível para máquinas, ou para fazer plástico.'"
	}

