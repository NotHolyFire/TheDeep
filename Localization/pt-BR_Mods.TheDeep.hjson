Items: {
	Applefin: {
		DisplayName: Maçãzinha
		Tooltip:
			'''
			Melhorias pequenas para todas as estatísticas
			'Maçãzinhas são peixes de água doce que se alimentam de algas e outras plantas aquáticas.
			Sua forma é parecida com uma maçã, que infelizmente para eles, não ajuda muito com sobrevivência.'
			'''
	}

	GoldenApplefin: {
		DisplayName: Maçãzinha Dourada
		Tooltip:
			'''
			Melhoria média para todas as estatísticas
			'Mas que original hein, você vai encantar ele agora?'
			'''
	}

